{
  "name": "ai-capsule",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @ai-capsule/api",
    "dev:web": "npm run dev --workspace @ai-capsule/web",
    "dev:ui": "npm run dev:web",
    "build": "npm run build --workspace @ai-capsule/web",
    "start": "npm run start --workspace @ai-capsule/api",
    "test": "npm run test --workspace @ai-capsule/api",
    "verify": "npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
